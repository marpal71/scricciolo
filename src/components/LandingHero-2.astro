---
import siteConfig from '../../site.config.mjs';

const owner = siteConfig.owner;
const base = import.meta.env.BASE_URL;
---

<div
	class="absolute top-[80px] bottom-[120px] left-0 right-0 z-0"
	style={{
		backgroundImage: `url(${base}images/tramonto.jpg)`,
		backgroundSize: 'cover',
		backgroundPosition: 'center',
		backgroundRepeat: 'no-repeat',
		opacity: 0.9,
	}}
>
</div>
<div class="container text-left mb-80 mt-10 relative z-10">
	<h1 class="text-3xl md:text-3xl lg:text-4xl font-bold leading-tight text-red-950">
		Scopri la Riviera di Ulisse e le Isole Pontine <br> in totale esclusività.
	</h1>
	<p class="mt-7 text-xl md:text-xl lg:text-2xl text-red-950">Noleggio con skipper per tour giornalieri,<br> 
		weekend e aperitivi al tramonto<br>a bordo di <b>Scricciolo3</b>
	</p>
	<!-- <a
		href=`${base}gallery`
		class="mt-8 inline-block px-6 py-3 border-2 border-black rounded-md
                      hover:bg-black hover:text-white transition-all duration-300
                      text-sm md:text-base font-medium
                      transform hover:scale-105 active:scale-95"
	>
		View Gallery
	</a> -->
</div>
