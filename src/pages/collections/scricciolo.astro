---
import MainLayout from '../../layouts/MainLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { getImages } from '../../data/imageStore';

const collectionName = 'Scricciolo';
const images = await getImages({ collection: 'scricciolo', sortBy: 'captureDate', order: 'desc' });
---

<MainLayout>
	<section class="py-16 pt-24">
		<div class="container-custom">
			<div class="mb-16 text-center">
				<h1 class="text-4xl md:text-5xl font-bold mb-4">{collectionName}</h1>
			</div>

			<PhotoGrid images={images} />
		</div>
	</section>
</MainLayout>
