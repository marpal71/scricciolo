---
import MainLayout from '../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';
import { promises as fs } from 'fs';
import yaml from 'js-yaml';
import path from 'path';

const aboutEntry = await getEntry('about', 'about');
const { Content: AboutPage } = await aboutEntry.render();

const profileImage = 'images/captain.jpg';
const base = import.meta.env.BASE_URL;

// Funzione per leggere e parsare il file delle recensioni
async function getReviews() {
  try {
    const filePath = path.join(process.cwd(), 'src', 'data', 'recensioni.txt');
    const fileContent = await fs.readFile(filePath, 'utf8');
    const frontmatter = fileContent.split('---')[1];
    if (!frontmatter) return [];
    const data = yaml.load(frontmatter);
    return data.reviews || [];
  } catch (error) {
    console.error("Errore durante la lettura delle recensioni:", error);
    return [];
  }
}

const reviews = await getReviews();

const title = "Chi siamo - Il tuo comandante per un giorno";
const description = "Scopri la passione e l'esperienza del nostro equipaggio. Con anni di navigazione nel Mar Tirreno, ti garantiamo un'avventura indimenticabile e in totale sicurezza.";
---

<MainLayout
    title={title}
    description={description}
    image={profileImage}
>
	<section class="pt-32 pb-20 bg-slate-50">
		<div class="container mx-auto px-4 md:px-6">
			<div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-2">
					<div class="relative group">
						<div class="absolute -inset-2 md:-inset-4 bg-sky-100 rounded-2xl opacity-50 blur-xl group-hover:opacity-70 transition-opacity duration-500"></div>
						<img
							src=`${base}${profileImage}`
							alt="Gli skipper BC"
							class="relative w-full h-auto rounded-2xl shadow-xl border-4 border-white"
							width="720"
							height="720"
						/>
					</div>
				</div>

				<div class="lg:col-span-3 prose max-w-none text-slate-600 leading-relaxed">
					<h1 class="text-3xl md:text-4xl font-bold text-sky-950 mb-6">
						Il tuo Comandante per un Giorno
					</h1>
					<AboutPage />
				</div>
			</div>
		</div>
	</section>

	<section class="py-20 bg-white">
		<div class="container mx-auto px-4 md:px-6">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h2 class="text-3xl md:text-4xl font-bold text-sky-950 mb-4">
					Dicono di Noi
				</h2>
				<p class="text-lg text-slate-600">
					Le parole di chi ha già vissuto un'esperienza a bordo di Scricciolo3.
				</p>
				<div class="w-24 h-1 bg-sky-500 mx-auto mt-6 rounded-full"></div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{reviews.map((review) => (
					<div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 p-8 border border-slate-100 flex flex-col">
						<div class="flex-grow mb-4">
							<p class="text-slate-600 italic">"{review.text}"</p>
						</div>
						<div class="flex items-center">
                            {review.link && review.link !== '#' ? (
                                <a href={review.link} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center font-bold text-sky-900 hover:text-sky-600 transition-colors">
                                    <span>- {review.author}</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5 ml-2 transform-gpu transition-transform group-hover:translate-x-1">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                                    </svg>
                                </a>
                            ) : (
                                <p class="font-bold text-sky-900">- {review.author}</p>
                            )}
							<div class="ml-auto flex items-center">
								{[...Array(review.stars)].map(() => (
									<svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.96a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.364 1.118l1.287 3.96c.3.921-.755 1.688-1.54 1.118l-3.368-2.448a1 1 0 00-1.176 0l-3.368 2.448c-.784.57-1.838-.197-1.54-1.118l1.287-3.96a1 1 0 00-.364-1.118L2.05 9.387c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.96z" />
									</svg>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>
</MainLayout>