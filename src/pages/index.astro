---
import MainLayout from '../layouts/MainLayout.astro';
import LandingHero from '../components/LandingHero-2.astro';
import FeaturedGallery from '../components/FeaturedGallery.astro';
import FeaturedWorkScroll from '../components/FeaturedWorkScroll.astro';
const base = import.meta.env.BASE_URL;
const features = [
{
	title: "Relax Totale",
	description: "Dimentica la folla e il rumore delle spiagge affollate. Qui ci siete solo tu, il rumore del mare e il silenzio. Riconnettiti con la natura in totale privacy.",
	image: "images/ragazza.jpg",
	alt: "Ragazza che prende il sole in barca"
},
{
	title: "Itinerari Segreti",
	description: "Ti porterò nelle calette accessibili solo via mare che le guide turistiche non conoscono. Scopri grotte nascoste e piscine naturali tra Gaeta e Ponza.",
	image: "images/palm_grottaDellaCattedrale.jpg",
	alt: "Grotta marina e acqua cristallina"
},
{
	title: "All-Inclusive & Zero Stress",
	description: "Skipper esperto, aperitivo a bordo con prodotti locali e attrezzatura snorkeling inclusa. Tu sali a bordo e pensi solo a divertirti, al resto pensiamo noi.",
	image: "images/aperitivo.jpg",
	alt: "Aperitivo in barca al tramonto"
}
];
const newImages = [
    {
        src: "images/LocandinaSenzaPrezzo.jpg",
        alt: "Locandina con i prezzi dei tour in barca"
    },
    {
        src: "images/prua.jpg",
        alt: "Prua della barca in navigazione"
    },
    {
        src: "images/barca.jpg",
        alt: "La barca Scricciolo in mare"
    }
];
---

<MainLayout>
	<section class="relative min-h-screen items-center flex py-10 md:py-4 overflow-hidden">
		<LandingHero />
		<!-- <FeaturedWorkScroll /> -->
	</section>
	
	<section class="pb-5 pt-1 bg-slate-50" id="esperienza">
		<div class="container mx-auto px-4 md:px-6">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h2 class="text-3xl md:text-4xl font-bold text-sky-950 mb-4">
					Il mare come non l'hai mai vissuto
				</h2>
				<p class="text-lg text-slate-700 leading-relaxed">
					Non offriamo solo un passaggio in barca, ma un'esperienza sensoriale completa lungo la Riviera di Ulisse.
				</p>
				<div class="w-24 h-1 bg-sky-500 mx-auto mt-6 rounded-full"></div>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-16">
				{features.map((feature) => (
					<div class="group bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-slate-100 flex flex-col h-full">	
						<div class="relative h-64 overflow-hidden">
							<img 
							src={feature.image} 
							alt={feature.alt} 
							class="w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-105"
							loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
						</div>
						
						<div class="p-8 flex-grow flex flex-col">
							<h3 class="text-xl font-bold text-sky-900 mb-3 group-hover:text-sky-600 transition-colors duration-300">
								{feature.title}
							</h3>
							<p class="text-slate-700 leading-relaxed">
								{feature.description}
							</p>
						</div>	
					</div>
				))}
			</div>
				
			<div class="text-center mt-16">
				<a href=`${base}collections/scricciolo` class="inline-flex items-center justify-center gap-2 text-sky-900 font-semibold hover:text-sky-600 transition-colors duration-300 border-b-2 border-sky-200 hover:border-sky-600 pb-1">
					Scopri i dettagli della barca
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1">
						<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
					</svg>
				</a>
			</div>
		</div>
	</section>

    <section class="py-10 bg-white" id="formia">
        <div class="container mx-auto px-4 md:px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-24 items-center">
                <div class="md:order-last group">
                    <div class="relative">
                        <div class="absolute -inset-2 md:-inset-4 bg-sky-100 rounded-2xl opacity-50 blur-xl group-hover:opacity-70 transition-opacity duration-500"></div>
                        <img
                            src=`${base}images/MappaFormiaGpt.jpg`
                            alt="Mappa del porto di Formia"
                            class="relative w-2/3 mx-auto h-auto rounded-2xl shadow-xl border-4 border-white transition-transform duration-500 ease-in-out group-hover:scale-105"
                        />
                    </div>
                </div>
    
                <div class="flex flex-col space-y-6">
                    <p class="pb-8 text-sky-600 text-center text-3xl font-bold tracking-wider uppercase">Senza Stress</p>
                    <h2 class="pb-7 text-3xl md:text-4xl font-bold text-sky-950">
                        Raggiungici in Treno, Parti dal Cuore di Formia
                    </h2>
                    <p class="text-lg text-slate-700 leading-relaxed">
                        Lascia a casa l'auto e lo stress del traffico. La stazione di Formia è a pochi minuti dal nostro punto di imbarco. Inizia la tua giornata di mare in totale relax.
                    </p>
                    <ul class="space-y-4 text-slate-700">
                        <li class="flex items-start">
                            <svg class="h-6 w-6 text-sky-500 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span><strong>Comodità Massima:</strong> Niente parcheggio, niente attese.</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="h-6 w-6 text-sky-500 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span><strong>Inizio Immediato:</strong> Scendi dal treno e sei quasi a bordo.</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="h-6 w-6 text-sky-500 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span><strong>Sostenibilità:</strong> Una scelta ecologica per goderti il mare.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

	<section class="py-16 bg-slate-50" id="gallery-preview">
        <div class="container mx-auto px-4 md:px-6">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <h2 class="text-3xl md:text-4xl font-bold text-sky-950 mb-4">
                    Uno Sguardo a Bordo
                </h2>
                <p class="text-lg text-slate-700 leading-relaxed">
                    Immagina di essere qui, cullato dalle onde, con il sole sulla pelle e un panorama mozzafiato.
                </p>
                <div class="w-24 h-1 bg-sky-500 mx-auto mt-6 rounded-full"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {newImages.map((image) => (
                    <a href={image.src} class="glightbox-preview group overflow-hidden rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 border border-slate-100">
                        <img src={image.src} alt={image.alt} class="w-full h-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105" loading="lazy" />
                    </a>
                ))}
            </div>
        </div>
    </section>

	<section class="bg-sky-800 text-white" id="contatti">
		<div class="container mx-auto px-4 md:px-6 py-16 text-center">
			<h2 class="text-3xl md:text-4xl font-bold mb-4">
				Pronto a Salpare con Noi?
			</h2>
			<p class="text-lg text-sky-200 max-w-2xl mx-auto mb-8">
				Contattaci per personalizzare la tua escursione o per richiedere maggiori informazioni. La tua avventura nel blu ti aspetta.
			</p>
			<div class="flex justify-center items-center space-x-4">
				<a href="mailto:mapalmerio@gmail.com" class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-base font-medium rounded-lg text-sky-800 bg-white hover:bg-sky-100 transition duration-300 ease-in-out shadow-lg transform hover:-translate-y-1">
					Scrivici un'email
				</a>
				<a href="https://wa.me/3920386967/" class="inline-flex items-center justify-center px-6 py-4 border border-transparent text-base font-medium rounded-lg text-white bg-green-500 hover:bg-green-600 transition duration-300 ease-in-out shadow-lg transform hover:-translate-y-1">
					Scrivici su WhatsApp
				</a>
			</div>
		</div>
	</section>

	<section class="featured-section py-24 bg-slate-50">
		<FeaturedGallery />
	</section>
</MainLayout>

<script>
    import { setupImagePreview } from '../scripts/image-preview';
    setupImagePreview();
</script>
